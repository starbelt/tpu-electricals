	(text "U4 units 7-9: GPIO_SD, GPIO_AD, GPIO_DISP\n\n- FlexSPI A (QSPI NAND), BT_CFG straps\n- 74LVC2G66 boot and MCM I2C isolation\n- I2C pull-ups\n- ADC divider (5 V max to 1.66 V)\n- A71CH crypto, IC2 (obsolete)"
		(exclude_from_sim no)
		(at 20.955 99.06 0)
